{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "docs/**"
    }
  },
  "routes": [
    { "src": "/swagger", "dest": "/api/index.ts" },
    { "src": "/swagger.json", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
